# Example environment variables for Tuk Tracker API
MONGODB_URI=mongodb://localhost:27017/tuk_tracker
JWT_SECRET=verysecretkey
ADMIN_USER=admin
ADMIN_PASS=admin123
OPERATOR_USER=operator
OPERATOR_PASS=operator123
PORT=5000
PUBLIC_URL=http://localhost:5000
REQUIRE_MONGODB=false
SIMULATION_DATE=2026-10-10
CORS_ORIGIN=*

# Replace with your student ID (required in README.md)
STUDENT_ID=YOUR_STUDENT_ID_HERE
