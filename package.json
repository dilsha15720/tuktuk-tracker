{
  "name": "tuk-tracker-api",
  "version": "1.0.0",
  "description": "Starter RESTful API for Tuk Tracker (assignment scaffold)",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node src/seed/seed.js",
    "seed:coursework": "node src/db/seed.js",
    "simulate": "node simulator/run.js",
    "validate:simulation": "node scripts/validate_simulation.js",
    "export:csv": "node scripts/json-to-csv.js",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "joi": "^18.2.9",
    "js-yaml": "^4.1.1",
    "jsonwebtoken": "^9.0.0",
    "mongodb": "^7.2.0",
    "mongoose": "^7.0.0",
    "morgan": "^1.12.1",
    "swagger-ui-express": "^4.6.3",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "jest": "^29.0.0",
    "mongodb-memory-server": "^8.10.1",
    "nodemon": "^2.0.20",
    "prettier": "^3.9.9",
    "supertest": "^6.3.3"
  }
}
